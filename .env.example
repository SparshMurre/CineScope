# CineScope Environment Variables
# Get a free OMDb API key at: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key_here

# Optional: Google Gemini API Key for server-side AI movie recommendations
# Kept server-side only; never prefixed with VITE_ or exposed in browser bundles.
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
